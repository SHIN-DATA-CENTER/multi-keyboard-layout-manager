// The remaining pages (design m3 B.10 to B.15): conflict resolution, history, the recovery
// prompt (with its undo and revert previews), the IME guide, settings and About. Every control is
// off while a dialog is open over the page (`Modal`, design m3 E.1).

import { AboutSlint, Button, CheckBox, ComboBox, ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import {
    ChoiceVm, ConflictKeyboardVm, JournalRowVm, RecoveryItemVm, RecoveryPageVm, Tone,
    UninstallRestoreVm, UpdateSettingsVm,
} from "../structs.slint";
import {
    Banner, Body, Caption, DialogBody, DialogButtons, Modal, PageHeader, RadioList,
    UacExplanation,
} from "../widgets.slint";

// Decide what each keyboard of an operation in conflict becomes (design m2 D.8; review U6): one
// row per keyboard, options by layout name, the recommended one marked; the per-value numbers and
// a per-value override are folded under "詳細". A restore to before MKLM that stopped at values
// changed outside MKLM uses the same page with one choice for the whole restore (leave those
// values, or put them back too) and no per-value override.
export component ConflictScreen inherits VerticalLayout {
    in property <string> operation;
    in property <[ConflictKeyboardVm]> keyboards;
    // The choices of a value in the details (index 0 follows the keyboard's option); empty for a
    // stopped restore.
    in property <[string]> value-options;
    in property <string> error;
    // The line about the Windows prompt that follows (design m3 B.5).
    in property <string> uac-line;
    // No entry in conflict: the page only says so.
    in property <string> empty-note;
    // A stopped restore: what happened, and the two ways to send it again.
    in property <string> restore-note;
    in property <[ChoiceVm]> restore-choices;
    in-out property <int> restore-selected: -1;
    in property <bool> can-resolve;
    in property <bool> can-undo;
    in-out property <bool> show-details: false;
    // (keyboard, option)
    callback choice(int, int);
    // (record, option)
    callback value-choice(int, int);
    callback restore-choice(int);
    callback resolve();
    callback undo();
    callback cancel();
    padding: 16px;
    spacing: 12px;

    PageHeader {
        title: @tr("Some keyboard settings changed outside MKLM");
        subtitle: root.operation;
    }

    DialogBody {
        if root.empty-note != "": Body {
            text: root.empty-note;
        }
        if root.restore-note != "": Banner {
            text: root.restore-note;
            tone: Tone.warning;
        }
        if root.error != "": Banner {
            text: root.error;
            tone: Tone.danger;
            accessible-live-region: assertive;
        }
        for keyboard[index] in root.keyboards: VerticalLayout {
            spacing: 2px;
            Body {
                text: keyboard.name;
                font-weight: 600;
            }

            Caption {
                text: keyboard.now;
            }

            if keyboard.baseline != "": Caption {
                text: keyboard.baseline;
            }
            if keyboard.options.length > 0: ComboBox {
                model: keyboard.options;
                current-index: keyboard.selected;
                enabled: !Modal.open;
                accessible-label: @tr("What {} becomes", keyboard.name);
                selected => {
                    root.choice(index, self.current-index);
                }
            }
            if keyboard.write-error != "": Banner {
                text: keyboard.write-error;
                tone: Tone.warning;
            }
            if root.show-details: VerticalLayout {
                spacing: 2px;
                for value in keyboard.values: VerticalLayout {
                    spacing: 2px;
                    Caption {
                        text: value.line;
                    }

                    if root.value-options.length > 0: ComboBox {
                        model: root.value-options;
                        current-index: value.selected;
                        enabled: !Modal.open;
                        accessible-label: @tr("What this value becomes");
                        selected => {
                            root.value-choice(value.record, self.current-index);
                        }
                    }
                }
            }
        }
        if root.restore-choices.length > 0: RadioList {
            label: @tr("What to do with the values changed outside MKLM");
            choices: root.restore-choices;
            selected <=> root.restore-selected;
            chosen(index) => {
                root.restore-choice(index);
            }
        }
        if root.keyboards.length > 0: CheckBox {
            text: @tr("Show the details");
            enabled: !Modal.open;
            checked <=> root.show-details;
        }
        if root.can-resolve && root.uac-line != "": Caption {
            text: root.uac-line;
        }
    }

    DialogButtons {
        alignment: stretch;
        if root.can-undo: Button {
            text: @tr("Undo every change waiting for you…");
            enabled: !Modal.open;
            clicked => {
                root.undo();
            }
        }
        Rectangle {
            horizontal-stretch: 1;
        }

        Button {
            text: @tr("Cancel");
            enabled: !Modal.open;
            clicked => {
                root.cancel();
            }
        }

        if root.can-resolve: Button {
            text: @tr("Apply the choices");
            primary: true;
            enabled: !Modal.open;
            clicked => {
                root.resolve();
            }
        }
    }
}

// The journal, read-only, in local time (design m3 B.11, G.1).
export component JournalScreen inherits VerticalLayout {
    in property <[JournalRowVm]> rows;
    in property <string> empty-text;
    // Entries of a newer MKLM: update first (design m2 C.10).
    in property <string> notice;
    // Why no revert is offered now (an interrupted or busy operation).
    in property <string> blocked-note;
    // The recovery files folder could not be opened.
    in property <string> folder-error;
    callback revert(string);
    callback open-recovery-folder();
    padding: 16px;
    spacing: 12px;

    PageHeader {
        title: @tr("History");
    }

    if root.notice != "": Banner {
        text: root.notice;
        tone: Tone.danger;
    }
    if root.empty-text != "": Caption {
        text: root.empty-text;
    }
    if root.blocked-note != "": Banner {
        text: root.blocked-note;
        tone: Tone.info;
    }
    ScrollView {
        vertical-stretch: 1;
        VerticalLayout {
            spacing: 6px;
            alignment: start;
            for row in root.rows: HorizontalLayout {
                spacing: 8px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    Body {
                        text: row.when + "  " + row.what;
                    }

                    Text {
                        text: row.state + (row.reason != "" ? " — " + row.reason : "");
                        font-size: Theme.font-body;
                        color: Theme.tone-text(row.tone);
                        wrap: word-wrap;
                    }

                    Caption {
                        text: row.op;
                    }
                }

                if row.can-revert: Button {
                    text: @tr("Revert…");
                    enabled: !Modal.open;
                    accessible-label: row.revert-label;
                    clicked => {
                        root.revert(row.op-id);
                    }
                }
            }
        }
    }

    if root.folder-error != "": Banner {
        text: root.folder-error;
        tone: Tone.warning;
    }
    HorizontalLayout {
        alignment: start;
        Button {
            text: @tr("Open the recovery files folder");
            enabled: !Modal.open;
            clicked => {
                root.open-recovery-folder();
            }
        }
    }
}

// What the journal needs (design m2 D.7, m3 B.12; review U9): each entry with what recovering
// will do to it; one primary button. The same page previews "undo every change waiting for you"
// and the history's revert of one operation, with the choice of how a HID keyboard switches back
// (design m3 B.5).
export component RecoveryScreen inherits VerticalLayout {
    in property <RecoveryPageVm> page;
    in property <[RecoveryItemVm]> items;
    // Switch back now / when replugged: kept by Rust (a literal array here would be a new model,
    // and new radio buttons, at every change of `page`).
    in property <[ChoiceVm]> method-choices;
    // 0 = switch back now, 1 = when replugged or at the restart (the state's choice).
    in-out property <int> method: 1;
    callback choose-method(int);
    // The primary button (the method is the state's).
    callback recover();
    callback undo();
    // "このままにする" / "元に戻す…" of an entry that waits for the user (operation ID).
    callback keep(string);
    callback revert(string);
    callback later();
    padding: 16px;
    spacing: 12px;

    PageHeader {
        title: root.page.title;
    }

    DialogBody {
        if root.page.empty-note != "": Body {
            text: root.page.empty-note;
        }
        for item in root.items: VerticalLayout {
            spacing: 2px;
            Body {
                text: item.operation;
                font-weight: 600;
            }

            Banner {
                text: item.outcome;
                tone: item.tone;
            }

            if item.can-keep || item.can-revert: HorizontalLayout {
                spacing: 8px;
                alignment: start;
                if item.can-keep: Button {
                    text: @tr("Keep");
                    enabled: !Modal.open;
                    accessible-label: item.keep-label;
                    clicked => {
                        root.keep(item.op-id);
                    }
                }
                if item.can-revert: Button {
                    text: @tr("Revert…");
                    enabled: !Modal.open;
                    accessible-label: item.revert-label;
                    clicked => {
                        root.revert(item.op-id);
                    }
                }
            }
        }
        if root.page.method-visible: RadioList {
            label: @tr("How the keyboard switches back");
            choices: root.method-choices;
            selected <=> root.method;
            chosen(index) => {
                root.choose-method(index);
            }
        }
        if root.page.later-note != "": Caption {
            text: root.page.later-note;
        }
        if root.page.uac-line != "": Caption {
            text: root.page.uac-line;
        }
    }

    DialogButtons {
        Button {
            text: root.page.dismiss-text;
            enabled: !Modal.open;
            clicked => {
                root.later();
            }
        }

        if root.page.can-undo: Button {
            text: @tr("Undo every change waiting for you…");
            enabled: !Modal.open;
            clicked => {
                root.undo();
            }
        }
        if root.page.can-recover: Button {
            text: root.page.primary-text;
            primary: true;
            enabled: !Modal.open;
            clicked => {
                root.recover();
            }
        }
    }
}

// How to use per-keyboard layouts with the Japanese IME (plan 3.10, design m3 B.13): guidance, and
// buttons that open the allowlisted Windows settings pages (`mklm_win::ui::SettingsPage`). MKLM
// writes no IME setting.
export component ImeHelpScreen inherits VerticalLayout {
    // 0 = Language & region, 1 = Advanced keyboard settings, 2 = Microsoft IME, 3 = Region
    // (intl.cpl).
    callback open-settings-page(int);
    padding: 16px;
    spacing: 12px;

    PageHeader {
        title: @tr("Input methods and the Japanese IME");
    }

    DialogBody {
        Body {
            text: @tr("Per-keyboard layouts work only while the Japanese IME is the active input method. To type English, turn the IME off (Alt+` or the 半角/全角 key) instead of switching to English (US): while English (US) is active, every keyboard types US.");
        }

        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            Button {
                text: @tr("Language settings");
                enabled: !Modal.open;
                clicked => {
                    root.open-settings-page(0);
                }
            }

            Button {
                text: @tr("Advanced keyboard settings");
                enabled: !Modal.open;
                clicked => {
                    root.open-settings-page(1);
                }
            }
        }

        Body {
            text: @tr("A US keyboard has no 半角/全角 key: turn the IME on and off with Alt+`. To use Ctrl+Space instead: Microsoft IME settings → Keys and touch customization → turn on \"Assign your preferred function to each key/key combination\" → Ctrl + Space: IME on/off.");
        }

        HorizontalLayout {
            alignment: start;
            Button {
                text: @tr("Microsoft IME settings");
                enabled: !Modal.open;
                clicked => {
                    root.open-settings-page(2);
                }
            }
        }

        Body {
            text: @tr("The sign-in screen has input methods of its own. To give it yours: Region → Administrative → Copy settings… → turn on \"Welcome screen and system accounts\" → OK (Windows asks for administrator permission).");
        }

        HorizontalLayout {
            alignment: start;
            Button {
                text: @tr("Region (copy settings)");
                enabled: !Modal.open;
                clicked => {
                    root.open-settings-page(3);
                }
            }
        }
    }
}

// The settings (design m3 B.14). Theme and language apply at once; the sign-in start is the HKCU
// Run value itself; "確認の時間を長くする" and "非表示と未接続も表示" are kept in settings.toml;
// "アンインストール時にキーボードの設定を元に戻す" is machine-wide: "変更…" opens a confirmation
// with what it means and what the Windows prompt looks like, and only its button starts the
// helper (design m3 0.2 principle 6).
export component SettingsScreen inherits VerticalLayout {
    // 0 = light, 1 = dark, 2 = system.
    in-out property <int> theme-index;
    // 0 = Japanese, 1 = English, 2 = system.
    in-out property <int> language-index;
    in-out property <bool> autostart;
    // Off while Task Manager disabled the value (design m3 F.3): MKLM never turns it back on.
    in property <bool> autostart-available: true;
    in property <string> autostart-note;
    // "確認の時間を長くする（60 秒）" (review U10).
    in-out property <bool> long-countdown;
    // "非表示と未接続のキーボードも表示する", the same setting as on the main screen.
    in-out property <bool> show-hidden;
    in property <UninstallRestoreVm> uninstall;
    // "更新を自動で確認する" (design m5b E.1) and what the last checks found.
    in-out property <bool> update-auto-check;
    in property <UpdateSettingsVm> update;
    callback theme-selected(int);
    callback language-selected(int);
    callback autostart-toggled(bool);
    callback long-countdown-toggled(bool);
    callback show-hidden-toggled(bool);
    callback uninstall-change();
    callback uninstall-cancel();
    callback uninstall-confirm();
    callback restore-all();
    callback run-wizard();
    callback update-auto-check-toggled(bool);
    callback update-check-now();
    callback open-update-page();
    // The confirmation closed: the focus goes back to its "変更…" button.
    private property <bool> confirm-open: root.uninstall.confirm-open;
    changed confirm-open => {
        if (!self.confirm-open && !Modal.open) {
            change-button.focus();
        }
    }
    padding: 16px;
    spacing: 12px;

    PageHeader {
        title: @tr("Settings");
    }

    DialogBody {
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            Body {
                text: @tr("Theme");
                vertical-alignment: center;
            }

            ComboBox {
                model: [@tr("Light"), @tr("Dark"), @tr("System")];
                current-index <=> root.theme-index;
                enabled: !Modal.open;
                accessible-label: @tr("Theme");
                selected => {
                    root.theme-selected(self.current-index);
                }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            Body {
                text: @tr("Language");
                vertical-alignment: center;
            }

            // Each language by its own name.
            ComboBox {
                model: ["日本語", "English", @tr("System")];
                current-index <=> root.language-index;
                enabled: !Modal.open;
                accessible-label: @tr("Language");
                selected => {
                    root.language-selected(self.current-index);
                }
            }
        }

        CheckBox {
            text: @tr("Start MKLM on the taskbar (inside \"^\") when I sign in");
            checked <=> root.autostart;
            enabled: root.autostart-available && !Modal.open;
            toggled => {
                root.autostart-toggled(self.checked);
            }
        }

        if root.autostart-note != "": Caption {
            text: root.autostart-note;
        }
        CheckBox {
            text: @tr("Give me more time to check a new layout (60 seconds)");
            checked <=> root.long-countdown;
            enabled: !Modal.open;
            toggled => {
                root.long-countdown-toggled(self.checked);
            }
        }

        Caption {
            text: @tr("After a keyboard switches, MKLM puts it back unless you keep the new layout within 20 seconds; with this setting, within 60 seconds.");
        }

        CheckBox {
            text: @tr("Show hidden and disconnected keyboards");
            checked <=> root.show-hidden;
            enabled: !Modal.open;
            toggled => {
                root.show-hidden-toggled(self.checked);
            }
        }

        HorizontalLayout {
            spacing: 8px;
            Body {
                text: root.uninstall.status;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            change-button := Button {
                text: @tr("Change…");
                enabled: root.uninstall.can-change && !root.uninstall.confirm-open && !Modal.open;
                accessible-label: @tr("Change what uninstalling MKLM does to the keyboards");
                clicked => {
                    root.uninstall-change();
                }
            }
        }

        if root.uninstall.note != "": Caption {
            text: root.uninstall.note;
        }
        // The confirmation (design m3 B.14): what the new value means, then the Windows prompt.
        if root.uninstall.confirm-open: Rectangle {
            border-width: 1px;
            border-color: Theme.border;
            border-radius: 6px;
            min-height: confirm.preferred-height;
            accessible-role: AccessibleRole.groupbox;
            accessible-label: root.uninstall.confirm-title;
            confirm := VerticalLayout {
                padding: 12px;
                spacing: 8px;
                // Takes the focus when the confirmation opens, so that it is read first.
                heading := FocusScope {
                    enabled: !Modal.open;
                    min-height: heading-text.preferred-height + 4px;
                    accessible-role: AccessibleRole.text;
                    accessible-label: root.uninstall.confirm-title;
                    accessible-description: root.uninstall.confirm-text;
                    init => {
                        self.focus();
                    }

                    Rectangle {
                        border-width: heading.has-focus ? Theme.focus-width : 0px;
                        border-color: Theme.focus-ring;
                        border-radius: 4px;
                    }

                    heading-text := Text {
                        x: 2px;
                        width: parent.width - 4px;
                        text: root.uninstall.confirm-title;
                        font-size: Theme.font-body;
                        font-weight: 600;
                        color: Theme.text;
                        wrap: word-wrap;
                        vertical-alignment: center;
                    }
                }

                Body {
                    text: root.uninstall.confirm-text;
                }

                if root.uninstall.uac-explanation: UacExplanation { }
                if !root.uninstall.uac-explanation && root.uninstall.uac-line != "": Caption {
                    text: root.uninstall.uac-line;
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    Button {
                        text: @tr("Cancel");
                        enabled: !Modal.open;
                        clicked => {
                            root.uninstall-cancel();
                        }
                    }

                    Button {
                        text: root.uninstall.confirm-button;
                        primary: true;
                        enabled: !Modal.open;
                        clicked => {
                            root.uninstall-confirm();
                        }
                    }
                }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            Button {
                text: @tr("Run the setup again…");
                enabled: !Modal.open;
                clicked => {
                    root.run-wizard();
                }
            }

            Button {
                text: @tr("Put every keyboard back to before MKLM…");
                enabled: !Modal.open;
                clicked => {
                    root.restore-all();
                }
            }
        }

        // Updates (design m5b E.2): the daily check, the last checks, and the way to the page.
        Body {
            text: @tr("Updates");
            font-weight: 600;
        }

        CheckBox {
            text: @tr("Check for updates automatically (once a day, MKLM asks GitHub)");
            checked <=> root.update-auto-check;
            enabled: !Modal.open;
            toggled => {
                root.update-auto-check-toggled(self.checked);
            }
        }

        Caption {
            text: root.update.last-check;
        }

        Caption {
            text: root.update.last-success;
        }

        if root.update.stale != "": Banner {
            text: root.update.stale;
            tone: Tone.info;
        }
        if root.update.expired != "": Banner {
            text: root.update.expired;
            tone: Tone.info;
        }
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            Button {
                text: @tr("Check now");
                enabled: root.update.can-check && !Modal.open;
                clicked => {
                    root.update-check-now();
                }
            }

            Button {
                text: @tr("Open the update page");
                enabled: !Modal.open;
                clicked => {
                    root.open-update-page();
                }
            }
        }
    }
}

// About MKLM (plan 3.12, design m3 B.15): the product, its version and build ID, the copyright and
// licence, the main third-party components (the full list generated at M5 replaces them), and
// the "Made with Slint" badge (AboutSlint) that Slint's royalty-free licence asks for.
export component AboutScreen inherits VerticalLayout {
    in property <string> version;
    // "Slint — Royalty-free License 2.0" and the like.
    in property <[string]> licences;
    padding: 16px;
    spacing: 12px;

    PageHeader {
        title: "Multi Keyboard Layout Manager";
        subtitle: root.version;
    }

    DialogBody {
        Body {
            text: "© 2026 SHIN DATA CENTER";
        }

        Caption {
            text: @tr("Licensed under the Apache License 2.0.");
        }

        Body {
            text: @tr("Main third-party components");
            font-weight: 600;
        }

        VerticalLayout {
            spacing: 2px;
            accessible-role: AccessibleRole.list;
            accessible-label: @tr("Main third-party components");
            for line in root.licences: Caption {
                text: line;
                accessible-role: AccessibleRole.list-item;
                accessible-label: line;
            }
        }
    }

    AboutSlint {
        vertical-stretch: 0;
        height: 140px;
    }
}

