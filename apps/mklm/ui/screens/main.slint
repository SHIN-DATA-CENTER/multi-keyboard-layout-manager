// The main screen (plan 3.2, design m3 B.2): the status line and the keyboard list grouped by
// physical device, with "identify by key press" (plan 3.3) marking the row that typed — with a
// badge and a border, never by colour alone (review U12) — scrolling it into view and saying
// which keyboard it is (polite, design m3 E.3).
//
// Each row has a menu (right click, Shift+F10 or the menu key): change, apply now, hide / show.
// "今すぐ反映…" and the banner's button open their pages (design m3 B.12). F5 reads everything
// again (design m3 E.1).

import { Button, CheckBox, ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { KeyboardRowVm, StatusVm, Tone, UpdateBannerVm } from "../structs.slint";
import { Badge, Banner, Body, CaptureArea, Caption, Modal, PageHeader } from "../widgets.slint";

// One item of the status line: its name above its value. The value wraps (a warning such as
// "英語 (US) ⚠ サインイン画面では…" is a sentence), so the line fits any window width down to the
// minimum size (design m3 E.4, review U11) and never cuts the warning off.
component StatusItem inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    in property <Tone> tone: Tone.neutral;
    spacing: 2px;
    alignment: start;
    horizontal-stretch: 1;
    accessible-role: AccessibleRole.text;
    accessible-label: root.label + ": " + root.value;
    Caption {
        text: root.label;
        accessible-role: AccessibleRole.none;
    }

    // The coloured box takes the value's width, and the column's when the value needs more.
    HorizontalLayout {
        alignment: start;
        Rectangle {
            background: Theme.tone-background(root.tone);
            border-color: Theme.tone-border(root.tone);
            border-width: Theme.high-contrast ? 1px : 0px;
            border-radius: 4px;
            VerticalLayout {
                padding-left: 5px;
                padding-right: 5px;
                padding-top: 2px;
                padding-bottom: 2px;
                Text {
                    text: root.value;
                    font-size: Theme.font-body;
                    color: Theme.tone-text(root.tone);
                    wrap: word-wrap;
                    accessible-role: AccessibleRole.none;
                }
            }
        }
    }
}

// One physical device. The whole row is one focus stop; Enter / Space opens the change page
// (design m3 E.1). The row keeps its identity across renders (the model is updated row by row,
// design m3 A.6), so the focus survives a key press elsewhere.
component KeyboardRow inherits Rectangle {
    in property <KeyboardRowVm> vm;
    callback assign();
    callback apply-now();
    callback toggle-hidden();
    // The row became the one "キーを押して特定" marks: the list scrolls it into view.
    callback reveal();
    private property <bool> marked: root.vm.highlighted;
    changed marked => {
        if (root.marked) {
            root.reveal();
        }
    }
    // A hidden row that just typed is inserted marked already.
    init => {
        if (root.marked) {
            root.reveal();
        }
    }
    background: vm.highlighted ? Theme.highlight-row : Theme.surface;
    border-radius: 6px;
    border-width: focus.has-focus || vm.highlighted ? (Theme.high-contrast && vm.highlighted ? 3px : Theme.focus-width) : 1px;
    border-color: vm.highlighted ? Theme.highlight-row-border : (focus.has-focus ? Theme.focus-ring : Theme.border);
    min-height: layout.preferred-height;

    // Right click, or Shift+F10 / the menu key on the focused row: the key reaches the area
    // because the row's FocusScope rejects it (design m3 B.2).
    ContextMenuArea {
        enabled: !Modal.open;
        Menu {
            MenuItem {
                title: @tr("Change…");
                enabled: root.vm.can-assign;
                activated => {
                    root.assign();
                }
            }

            if root.vm.apply-now: MenuItem {
                title: @tr("Apply now…");
                activated => {
                    root.apply-now();
                }
            }

            MenuSeparator { }

            MenuItem {
                title: root.vm.hidden ? @tr("Show this keyboard") : @tr("Hide this keyboard");
                activated => {
                    root.toggle-hidden();
                }
            }
        }

        focus := FocusScope {
            enabled: !Modal.open;
            accessible-role: AccessibleRole.list-item;
            accessible-label: root.vm.accessible-summary;
            accessible-description: @tr("Shift+F10 opens the menu (hide or show the keyboard).");
            accessible-action-default => {
                if (root.vm.can-assign) {
                    root.assign();
                }
            }
            key-pressed(event) => {
                if ((event.text == Key.Return || event.text == " ") && root.vm.can-assign) {
                    root.assign();
                    return accept;
                }
                reject
            }

            layout := HorizontalLayout {
                padding: 10px;
                spacing: 12px;
                // The name keeps some room at the minimum window size; the middle column gives
                // way next, the buttons never (they would be cut off).
                VerticalLayout {
                    spacing: 2px;
                    horizontal-stretch: 1;
                    min-width: 120px * Theme.font-scale;
                    Text {
                        text: root.vm.name;
                        font-size: Theme.font-body;
                        font-weight: 600;
                        color: root.vm.highlighted ? Theme.highlight-row-text : Theme.text;
                        wrap: word-wrap;
                    }

                    Caption {
                        text: root.vm.transport + "  " + root.vm.vid-pid;
                    }

                    HorizontalLayout {
                        spacing: 4px;
                        alignment: start;
                        for badge in root.vm.badges: Badge {
                            vm: badge;
                        }
                    }
                }

                // As wide as it needs up to 260 px (times the text size); narrower windows take
                // the space from the name first, then from here (the texts wrap), so that the
                // buttons stay inside the row at the minimum size (design m3 E.4).
                VerticalLayout {
                    spacing: 2px;
                    horizontal-stretch: 0;
                    min-width: 120px * Theme.font-scale;
                    preferred-width: 260px * Theme.font-scale;
                    Body {
                        text: @tr("Assigned: {}", root.vm.assigned);
                        color: root.vm.highlighted ? Theme.highlight-row-text : Theme.text;
                    }

                    if root.vm.pending != "": Caption {
                        text: root.vm.pending;
                    }
                    if root.vm.pending-hint != "": Caption {
                        text: root.vm.pending-hint;
                    }
                    Text {
                        text: root.vm.current;
                        font-size: Theme.font-body;
                        color: root.vm.highlighted ? Theme.highlight-row-text : Theme.tone-text(root.vm.current-tone);
                        wrap: word-wrap;
                    }

                    if root.vm.physical-note != "": Text {
                        text: root.vm.physical-note;
                        font-size: Theme.font-body;
                        color: Theme.tone-text(Tone.warning);
                        wrap: word-wrap;
                    }
                    if root.vm.blocked-note != "": Caption {
                        text: root.vm.blocked-note;
                    }
                }

                VerticalLayout {
                    spacing: 4px;
                    alignment: start;
                    horizontal-stretch: 0;
                    Button {
                        text: @tr("Change…");
                        enabled: root.vm.can-assign && !Modal.open;
                        accessible-label: root.vm.assign-label;
                        clicked => {
                            root.assign();
                        }
                    }

                    if root.vm.apply-now: Button {
                        text: @tr("Apply now…");
                        enabled: !Modal.open;
                        // "Keychron Receiver の配列を今すぐ反映" (design m3 E.2).
                        accessible-label: root.vm.apply-now-label;
                        clicked => {
                            root.apply-now();
                        }
                    }
                }
            }
        }
    }
}

// The page. The root only collects keys its parts do not use: F5 reads everything again (design
// m3 E.1). It never takes the focus itself.
export component MainScreen inherits FocusScope {
    in property <StatusVm> status;
    in property <[KeyboardRowVm]> keyboards;
    in property <bool> identify-active;
    // "Keychron Receiver のキーが押されました" (polite, design m3 B.3).
    in property <string> identify-announcement;
    in-out property <bool> show-hidden;
    // MKLM's update banner (design m5b E.3); none when its text is empty.
    in property <UpdateBannerVm> update-banner;
    callback assign(string);
    callback apply-now(string);
    callback toggle-hidden(string);
    callback show-hidden-toggled(bool);
    callback toggle-identify();
    callback banner-action();
    callback refresh();
    callback update-action(int);
    focus-on-click: false;
    focus-on-tab-navigation: false;
    min-width: page.min-width;
    min-height: page.min-height;
    key-pressed(event) => {
        if (event.text == Key.F5) {
            root.refresh();
            return accept;
        }
        reject
    }

    // Scrolls the list so that the row at `top` (list coordinates) is fully visible.
    function reveal-row(top: length, height: length) {
        if (top < -list.content-y) {
            list.content-y = -top;
        } else if (top + height > list.visible-height - list.content-y) {
            list.content-y = min(0px, list.visible-height - top - height);
        }
    }

    page := VerticalLayout {
        padding: 16px;
        spacing: 12px;

        PageHeader {
            title: @tr("Keyboards");
        }

        // The status line (plan 3.2): input method, mode, standard layout, sign-in screen, in
        // four columns of equal width whose values wrap.
        HorizontalLayout {
            spacing: 12px;
            StatusItem {
                label: @tr("Input method");
                value: root.status.input-method;
                tone: root.status.input-method-tone;
            }

            StatusItem {
                label: @tr("Mode");
                value: root.status.mode;
            }

            StatusItem {
                label: @tr("Standard layout");
                value: root.status.standard;
            }

            StatusItem {
                label: @tr("Sign-in screen");
                value: root.status.sign-in;
                tone: root.status.sign-in-tone;
            }
        }

        if root.status.mode-note != "": Caption {
            text: root.status.mode-note;
        }
        if root.status.banner != "": HorizontalLayout {
            spacing: 8px;
            Banner {
                text: root.status.banner;
                tone: root.status.banner-tone;
                horizontal-stretch: 1;
            }

            if root.status.banner-action != "": Button {
                text: root.status.banner-action;
                enabled: !Modal.open;
                clicked => {
                    root.banner-action();
                }
            }
        }
        // Updates (design m5b E.3): a new version, a long time without a check, an older
        // manifest ignored. Never in the way of the keyboards.
        if root.update-banner.text != "": HorizontalLayout {
            spacing: 8px;
            Banner {
                text: root.update-banner.text;
                tone: root.update-banner.tone;
                horizontal-stretch: 1;
            }

            for item in root.update-banner.actions: Button {
                text: item.text;
                accessible-label: item.accessible-label;
                enabled: !Modal.open;
                clicked => {
                    root.update-action(item.action);
                }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            Button {
                text: root.identify-active ? @tr("Stop identifying") : @tr("Identify by key press");
                enabled: !Modal.open;
                clicked => {
                    root.toggle-identify();
                }
            }

            Button {
                text: @tr("Refresh");
                enabled: !Modal.open;
                clicked => {
                    root.refresh();
                }
            }
        }

        // On a line of its own: next to the buttons it would not fit the minimum window width
        // (design m3 E.4; a check box does not wrap its text).
        HorizontalLayout {
            alignment: start;
            CheckBox {
                text: @tr("Show hidden and disconnected keyboards");
                enabled: !Modal.open;
                checked <=> root.show-hidden;
                toggled => {
                    root.show-hidden-toggled(self.checked);
                }
            }
        }

        // While identifying, the keys go here, so that Space or Enter on the keyboard being
        // looked for presses no button; Esc stops (review U12).
        if root.identify-active: CaptureArea {
            text: @tr("Press a key on the keyboard you want to find. Its row is marked \"◀ Just pressed\". Esc stops.");
            init => {
                self.focus-capture();
            }
            escape => {
                root.toggle-identify();
            }
        }
        // Which keyboard typed, in words too; read out politely when another row is marked.
        if root.identify-active: Body {
            text: root.identify-announcement;
            accessible-live-region: polite;
        }

        list := ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 8px;
                alignment: start;
                accessible-role: AccessibleRole.list;
                accessible-label: @tr("Keyboards");
                for row in root.keyboards: KeyboardRow {
                    vm: row;
                    assign => {
                        root.assign(row.id);
                    }
                    apply-now => {
                        root.apply-now(row.id);
                    }
                    toggle-hidden => {
                        root.toggle-hidden(row.id);
                    }
                    reveal => {
                        root.reveal-row(self.y, self.height);
                    }
                }
            }
        }
    }
}
