// Small building blocks shared by the screens (design m3 B, C, E).

import { Palette, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { BadgeVm, ChoiceVm, KeyTestVm, Tone } from "structs.slint";

// Whether an overlay (a dialog) is open over the page (design m3 E.1). Rust sets it together with
// the overlay (src/app.rs), so both change before the next frame. While it is open, the page's
// controls are disabled — every button, check box, combo box and focus scope of a page binds
// `enabled` to `!Modal.open` — so that Tab cannot leave the dialog for the page behind it; the
// dialog's frame swallows clicks and the wheel. Slint has no inert subtree, hence the binding on
// each control.
export global Modal {
    in-out property <bool> open: false;
}

// A coloured label. Screen readers get `vm.accessible-text` (design m3 E.3).
export component Badge inherits Rectangle {
    in property <BadgeVm> vm;
    background: Theme.tone-background(vm.tone);
    border-color: Theme.tone-border(vm.tone);
    border-width: Theme.high-contrast ? 1px : 0px;
    border-radius: 4px;
    min-width: label.preferred-width + 12px;
    height: label.preferred-height + 4px;
    accessible-role: AccessibleRole.text;
    accessible-label: vm.accessible-text != "" ? vm.accessible-text : vm.text;

    label := Text {
        text: vm.text;
        color: Theme.tone-text(vm.tone);
        font-size: Theme.font-caption;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// The title of a page (design m3 E.1, E.2). It takes the focus when the page opens, so that a
// screen reader reads the new page's title and the focus never disappears with the old page
// (pages are rebuilt by `if`; review U16 d). Tab moves on to the page's first control.
//
// A page opened under a dialog leaves the focus to the dialog. When the dialog closes, its
// controls are gone with it and the focus comes back here: Slint cannot tell which control had
// the focus before the dialog opened, and the page's title is a well-defined place to go on from.
export component PageHeader inherits VerticalLayout {
    in property <string> title;
    in property <string> subtitle;
    in property <bool> focus-on-open: true;
    private property <bool> page-active: !Modal.open;
    changed page-active => {
        if (self.page-active && root.focus-on-open) {
            heading.focus();
        }
    }
    spacing: 4px;

    // Moves the focus to the title again: a page whose content changes in place (the wizard's
    // steps) calls it, so that the new step is read from its title like a new page (design m3
    // B.0, E.1; review U16).
    public function focus-heading() {
        if (!Modal.open) {
            heading.focus();
        }
    }

    heading := FocusScope {
        enabled: !Modal.open;
        min-height: heading-layout.preferred-height;
        accessible-role: AccessibleRole.text;
        accessible-label: root.title;
        accessible-description: root.subtitle;
        init => {
            if (root.focus-on-open && !Modal.open) {
                self.focus();
            }
        }

        Rectangle {
            border-width: heading.has-focus ? Theme.focus-width : 0px;
            border-color: Theme.focus-ring;
            border-radius: 4px;
        }

        heading-layout := VerticalLayout {
            padding: 2px;
            Text {
                text: root.title;
                font-size: Theme.font-title;
                font-weight: 600;
                color: Theme.text;
                wrap: word-wrap;
            }
        }
    }

    if root.subtitle != "": Text {
        text: root.subtitle;
        font-size: Theme.font-body;
        color: Theme.text-secondary;
        wrap: word-wrap;
    }
}

// Secondary text.
export component Caption inherits Text {
    color: Theme.text-secondary;
    font-size: Theme.font-caption;
    wrap: word-wrap;
}

// Body text.
export component Body inherits Text {
    color: Theme.text;
    font-size: Theme.font-body;
    wrap: word-wrap;
}

// A banner line with a tone (attention, warnings, design m3 B.12).
export component Banner inherits Rectangle {
    in property <string> text;
    in property <Tone> tone: Tone.info;
    background: Theme.tone-background(tone);
    border-color: Theme.tone-border(tone);
    border-width: Theme.high-contrast ? 1px : 0px;
    border-radius: 6px;
    min-height: body.preferred-height + 12px;
    accessible-role: AccessibleRole.text;
    accessible-label: root.text;

    body := Text {
        x: 8px;
        width: parent.width - 16px;
        text: root.text;
        font-size: Theme.font-body;
        color: Theme.tone-text(root.tone);
        wrap: word-wrap;
        vertical-alignment: center;
    }
}

// Marks a part that a work package still has to build (design m3 I). Not translated.
export component StubNotice inherits Text {
    in property <string> package;
    text: "TODO(" + package + ")";
    color: Theme.text-secondary;
    font-size: 11px;
}

// Radio choices (design m3 E.1, E.2; review U16): one tab stop; the arrow keys move the
// selection; ◉ / ○ and a filled background show the selection, a separate outer ring the focus.
// Used for the layout choices and for the apply method (review U1). `label` is the group's
// accessible name and, above the choices, its visible heading ("切り替え方", design m3 B.4), so
// that sighted users see what the choices are for too.
export component RadioList inherits Rectangle {
    in property <[ChoiceVm]> choices;
    in-out property <int> selected: -1;
    in property <string> label;
    // Off under a dialog (design m3 E.1).
    in property <bool> enabled: !Modal.open;
    callback chosen(int);
    min-height: outer.preferred-height;

    function pick(index: int) {
        if (root.enabled && index >= 0 && index < root.choices.length && root.choices[index].enabled) {
            root.selected = index;
            root.chosen(index);
        }
    }

    function step(delta: int) {
        if (root.choices.length == 0) {
            return;
        }
        if (root.selected < 0) {
            root.pick(0);
            return;
        }
        root.pick(Math.clamp(root.selected + delta, 0, root.choices.length - 1));
    }

    public function focus-choices() {
        group.focus();
    }

    outer := VerticalLayout {
        spacing: 2px;

        // The group's name is read with the group; the heading is for the eyes.
        if root.label != "": Text {
            text: root.label;
            font-size: Theme.font-body;
            font-weight: 600;
            color: Theme.text;
            wrap: word-wrap;
            accessible-role: AccessibleRole.none;
        }

        group := FocusScope {
            enabled: root.enabled;
            accessible-role: AccessibleRole.radio-group;
            accessible-label: root.label;
            key-pressed(event) => {
                if (event.text == Key.DownArrow || event.text == Key.RightArrow) {
                    root.step(1);
                    return accept;
                }
                if (event.text == Key.UpArrow || event.text == Key.LeftArrow) {
                    root.step(-1);
                    return accept;
                }
                if (event.text == " " && root.selected < 0) {
                    root.pick(0);
                    return accept;
                }
                reject
            }

            list := VerticalLayout {
                padding: 4px;
                spacing: 6px;
                for choice[index] in root.choices: Rectangle {
                    min-height: item.preferred-height;
                    border-radius: 6px;
                    background: index == root.selected ? Theme.selected-fill : transparent;
                    border-width: 1px;
                    border-color: Theme.border;
                    accessible-role: AccessibleRole.radio-button;
                    accessible-label: choice.text;
                    accessible-description: choice.detail;
                    accessible-checked: index == root.selected;
                    accessible-enabled: choice.enabled && root.enabled;

                    // The focus ring, outside the fill: on the selected choice (or the first).
                    Rectangle {
                        x: -3px;
                        y: -3px;
                        width: parent.width + 6px;
                        height: parent.height + 6px;
                        border-radius: 8px;
                        border-width: group.has-focus && (index == root.selected || (root.selected < 0 && index == 0)) ? Theme.focus-width : 0px;
                        border-color: Theme.focus-ring;
                    }

                    TouchArea {
                        enabled: choice.enabled && root.enabled;
                        clicked => {
                            root.pick(index);
                            group.focus();
                        }
                    }

                    item := HorizontalLayout {
                        padding: 8px;
                        spacing: 8px;
                        Text {
                            text: index == root.selected ? "◉" : "○";
                            font-size: Theme.font-body;
                            color: index == root.selected ? Theme.selected-text : Theme.text;
                            vertical-alignment: top;
                            accessible-role: AccessibleRole.none;
                        }

                        VerticalLayout {
                            horizontal-stretch: 1;
                            Text {
                                text: choice.text;
                                font-size: Theme.font-body;
                                color: !choice.enabled ? Theme.text-disabled : (index == root.selected ? Theme.selected-text : Theme.text);
                                wrap: word-wrap;
                                accessible-role: AccessibleRole.none;
                            }

                            if choice.detail != "": Caption {
                                text: choice.detail;
                                accessible-role: AccessibleRole.none;
                            }
                        }
                    }
                }
            }
        }
    }
}

// The IME-free key test (plan 1.4, 3.3; M0 #8 B): a FocusScope keeps the IME off, so the
// characters come straight from the keyboard layout. Shift+2: "@" = US, "\"" = JIS. The Rust side
// adds which keyboard sent the key (winit DeviceEvent, design m3 A.4) and never logs the text.
// Tab and Esc are not swallowed: Tab leaves the field, Esc reaches the dialog (the countdown's
// "revert", design m3 E.1).
export component KeyTestArea inherits Rectangle {
    in property <KeyTestVm> vm;
    // The accessible description: the countdown passes its whole instruction (design m3 E.3).
    in property <string> description: vm.prompt;
    // On a page, off under a dialog (design m3 E.1); a dialog's own key test sets it to true.
    in property <bool> enabled: !Modal.open;
    // (text, shift)
    callback key-pressed(string, bool);
    out property <bool> focused: scope.has-focus;
    min-height: 120px * Theme.font-scale;
    border-radius: 6px;
    border-width: scope.has-focus ? Theme.focus-width : 1px;
    border-color: scope.has-focus ? Theme.focus-ring : Theme.border;
    background: Theme.surface;

    public function focus-test() {
        scope.focus();
    }

    scope := FocusScope {
        enabled: root.enabled;
        accessible-role: AccessibleRole.text-input;
        accessible-label: @tr("Key test");
        accessible-description: root.description;
        accessible-value: root.vm.last-text;
        key-pressed(event) => {
            if (event.text == Key.Tab || event.text == Key.Backtab || event.text == Key.Escape) {
                return reject;
            }
            root.key-pressed(event.text, event.modifiers.shift);
            accept
        }

        VerticalLayout {
            padding: 8px;
            spacing: 4px;
            Text {
                text: scope.has-focus ? root.vm.prompt : @tr("Click here, then press a key");
                font-size: Theme.font-body;
                color: Theme.text;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            Text {
                text: root.vm.last-text;
                font-size: Theme.font-key;
                color: Theme.text;
                horizontal-alignment: center;
            }

            Text {
                text: root.vm.verdict;
                font-size: Theme.font-body;
                color: Theme.tone-text(root.vm.verdict-tone);
                horizontal-alignment: center;
                wrap: word-wrap;
                accessible-live-region: polite;
            }

            Text {
                text: root.vm.device;
                font-size: Theme.font-caption;
                color: Theme.text-secondary;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }
    }
}

// Where the keys go while "identify by key press" runs (design m3 B.3; review U12): it takes
// the focus, swallows every key but Tab and Esc (so Space or Enter on the keyboard being looked
// for does not press a button), and Esc stops identifying.
export component CaptureArea inherits Rectangle {
    in property <string> text;
    // Off under a dialog (design m3 E.1).
    in property <bool> enabled: !Modal.open;
    callback escape();
    min-height: label.preferred-height + 16px;
    border-radius: 6px;
    border-width: scope.has-focus ? Theme.focus-width : 1px;
    border-color: scope.has-focus ? Theme.focus-ring : Theme.border;
    background: Theme.surface;

    public function focus-capture() {
        scope.focus();
    }

    scope := FocusScope {
        enabled: root.enabled;
        accessible-role: AccessibleRole.text-input;
        accessible-label: @tr("Identify by key press");
        accessible-description: root.text;
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.escape();
                return accept;
            }
            if (event.text == Key.Tab || event.text == Key.Backtab) {
                return reject;
            }
            accept
        }

        label := Text {
            x: 8px;
            width: parent.width - 16px;
            text: root.text;
            font-size: Theme.font-body;
            color: Theme.text;
            wrap: word-wrap;
            vertical-alignment: center;
        }
    }
}

// The frame of an overlay dialog (design m3 B.6, E.1, E.4): swallows clicks and the wheel on the
// page behind it (whose controls are off meanwhile, `Modal`); Esc that no part of the dialog
// handles calls `escape` (the countdown: revert). Dialogs are built of three parts: the title
// (here), a `DialogBody` that scrolls, and a `DialogButtons` row that always stays visible, so no
// button is ever drawn outside the frame at 200 % and a large text size (review U11).
//
// When the dialog opens, its frame takes the focus (design m3 E.1): a screen reader reads the
// title and `description`, Esc works at once, Tab goes on to the dialog's controls, and Enter or
// Space confirm nothing by accident (a UAC prompt starts only from a button the user chose). The
// countdown gives the focus to its key test instead (`focus-on-open: false`).
export component DialogFrame inherits Rectangle {
    in property <string> title;
    // What is read with the title when the dialog takes the focus.
    in property <string> description;
    in property <bool> focus-on-open: true;
    callback escape();
    background: #00000080;

    TouchArea {
        scroll-event(event) => {
            accept
        }
    }

    keys := FocusScope {
        accessible-role: AccessibleRole.groupbox;
        accessible-label: root.title;
        accessible-description: root.description;
        init => {
            if (root.focus-on-open) {
                self.focus();
            }
        }
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.escape();
                return accept;
            }
            reject
        }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(parent.width - 24px, 560px * Theme.font-scale);
            height: min(parent.height - 24px, inner.preferred-height);
            background: Theme.window-background;
            border-radius: 8px;
            // The frame itself shows the focus while it has it (design m3 E.1).
            border-width: keys.has-focus ? Theme.focus-width : 1px;
            border-color: keys.has-focus ? Theme.focus-ring : Theme.border;

            inner := VerticalLayout {
                padding: 16px;
                spacing: 12px;
                Text {
                    text: root.title;
                    font-size: Theme.font-dialog-title;
                    font-weight: 600;
                    color: Theme.text;
                    wrap: word-wrap;
                }

                @children
            }
        }
    }
}

// What the Windows prompt for an unsigned program says and what to check on it (plan 3.5 step
// 2; M2 R12: explain first, then prompt; review U18). The standalone page before the first change
// shows it, and so does the settings page before its first prompt. T-APPLY-1 checks the text
// against the real prompt.
export component UacExplanation inherits VerticalLayout {
    spacing: 8px;

    Body {
        text: @tr("The next screen asks \"Do you want to allow this app from an unknown publisher to make changes to your device?\". MKLM is not code-signed yet, so the verified publisher shows as \"Unknown\". Check that mklm-helper.exe is shown in the middle of the screen, then choose Yes.");
    }

    // A text mock of the prompt (review U18).
    Rectangle {
        border-width: 1px;
        border-color: Theme.border;
        border-radius: 6px;
        min-height: mock.preferred-height;
        accessible-role: AccessibleRole.groupbox;
        accessible-label: @tr("What the Windows prompt looks like");
        mock := VerticalLayout {
            padding: 12px;
            spacing: 4px;
            Caption {
                text: @tr("User Account Control");
            }

            Body {
                text: @tr("Do you want to allow this app from an unknown publisher to make changes to your device?");
                font-weight: 600;
            }

            Body {
                text: "mklm-helper.exe";
            }

            Caption {
                text: @tr("Verified publisher: Unknown");
            }

            Caption {
                text: @tr("File origin: Hard drive on this computer");
            }

            Caption {
                text: @tr("[Yes] [No]");
            }
        }
    }

    Body {
        text: @tr("On an account that is not an administrator, Windows asks for an administrator's password or PIN instead.");
    }

    Caption {
        text: @tr("Nothing is changed if you choose No.");
    }
}

// The scrolling middle of a dialog or page: shrinks (down to a few lines) before anything else
// does. Its parts keep their own heights and stack at the top: the scroll area's viewport is at
// least as tall as what is visible, and a stretching layout would hand the rest of that height
// to the texts, banners and buttons of a short page.
export component DialogBody inherits Rectangle {
    vertical-stretch: 1;
    preferred-height: content.preferred-height;
    min-height: min(content.preferred-height, 64px * Theme.font-scale);

    ScrollView {
        width: 100%;
        height: 100%;
        content := VerticalLayout {
            spacing: 8px;
            alignment: start;
            @children
        }
    }
}

// The button row of a dialog or page: never shrinks, always visible.
export component DialogButtons inherits HorizontalLayout {
    spacing: 8px;
    alignment: end;
    vertical-stretch: 0;
}
